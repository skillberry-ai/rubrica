# Pipeline run outputs (see docs/superpowers/specs/ — runs/<run-id>/ is disposable)
runs/

# Agent harness scratch: SDD ledgers, task briefs, review packages; worktrees
.superpowers/
.claude/worktrees/
.claude/.cc-writes/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Build artefacts (the schemas ship as package data, so `uv build` is meaningful)
build/
dist/
*.egg-info/

# IDE stuff
.vscode/

# uv.lock is tracked, deliberately -- it used to be ignored here. Measured on
# 2026-08-16: the lock pinned ruff 0.16.1 while a fresh resolution picked 0.16.3,
# so CI and a contributor's machine were two patch releases apart on a gate
# (`ruff format --check`) whose output can change across them. Both `make setup`
# and CI now install through `uv sync`, so both read this file; pinning only one
# of the two would have been worse than pinning neither, because CI could fail on
# a formatting difference the contributor could not reproduce. The cost accepted
# in exchange: a dependency bump is a reviewed diff via `uv lock --upgrade`.

# Secrets
.env
